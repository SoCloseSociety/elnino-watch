# /opt/elnino/.env on the VPS (root:elnino, mode 640). Read by systemd
# (EnvironmentFile) and by pydantic settings (app/config.py). first_setup.sh creates it
# from this file with a fresh ADMIN_TOKEN; edit it there, then
# `systemctl restart elnino-watch`. NEVER commit the real file.

# --- public deployment (app/security.py)
PUBLIC_MODE=true
# 64 hex chars. Generate: openssl rand -hex 32   (first_setup.sh does it for you)
ADMIN_TOKEN=__GENERATE_WITH_openssl_rand_hex_32__

# --- runtime
# uvicorn listens on 127.0.0.1:$PORT (nginx proxies to it). first_setup.sh refuses a busy port.
PORT=8911
# In-process scheduler: the collectors run inside the single uvicorn worker.
SCHEDULER=true
DB_PATH=/opt/elnino/data/elnino.db
# The one canonical origin (canonical links, sitemap, OG, JSON-LD, robots). No trailing slash.
PUBLIC_ORIGIN=https://elnino.example.com
# The watched place (default: the centre of Koh Samui). Any place works, the page texts stay Samui-centric.
HOME_NAME=Koh Samui
HOME_LAT=9.512
HOME_LON=100.013
HOME_RADIUS_KM=800
# Shown to data providers in the User-Agent so they can reach you (email or URL).
CONTACT=

# --- optional credentials (empty = the source shows needs_config, never fails silently)
FIRMS_MAP_KEY=
WINDY_WEBCAMS_KEY=
RELIEFWEB_APPNAME=
X_BEARER_TOKEN=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# LLM rewrite of the briefing (else the rules briefing is served, method "rules")
COMPUTEFORGE_KEY=

# --- alert delivery. Leave EMPTY here while the Mac instance also runs with them,
# otherwise every alert is sent twice (both schedulers evaluate the same risk).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Generic alert webhook: POST {NEO_API_URL}/device_alert with a Bearer token (docs/BOT_CONNECTOR.md)
NEO_API_URL=
NEO_API_TOKEN=
