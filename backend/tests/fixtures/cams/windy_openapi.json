       "longitude"
      ]
     }
    },
    "required": [
     "status",
     "webcamId",
     "title",
     "viewCount",
     "preview",
     "hasPanorama",
     "hasLivestream",
     "categories",
     "location"
    ]
   },
   "PublicApiExportWebcamsResponseDto": {
    "type": "object",
    "properties": {
     "updatedOn": {
      "type": "string"
     },
     "webcams": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/PublicApiExportWebcamsItemResponseDto"
      }
     }
    },
    "required": [
     "updatedOn",
     "webcams"
    ]
   },
   "GeoResponseDto": {
    "type": "object",
    "properties": {
     "code": {
      "type": "string",
      "description": "Geocode parameter that can be utilized as a filtering criterion."
     },
     "name": {
      "type": "string",
      "description": "The name of the location in the local language."
     }
    },
    "required": [
     "code",
     "name"
    ]
   }
  }
 }
}