{
 "openapi": "3.0.0",
 "paths": {
  "/webcams/api/v3/map/clusters": {
   "get": {
    "description": "\n<p>\n    For each zoom level, the returned webcams are arranged in such a way that they are nicely distributed and not too close to each other on the map.<br/>\n    The zoom levels correspond to those provided by the <a href=\"https://www.maptiler.com/google-maps-coordinates-tile-bounds-projection\" >Google MapTiler</a>.\n</p>\n<h3>\n    Maximum ranges for latitudes and longitudes at specified zoom levels:\n</h3>\n<p>\n    The maximum range of the bounding box is constrained by the chosen zoom level. At the highest zoom level (level 4), the difference in latitude cannot exceed 22.5 degrees (45 degrees for longitude).\n    Each lower zoom level reduces this limit by a factor of 2\n</p>\n\n<table id='ranges-table'>\n    <thead>\n        <tr>\n            <th>Zoom</th>\n            <th>Latitude</th>\n            <th>Longitude</th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr> \n                <td>4</td>\n                <td>22.5</td>\n                <td>45</td>\n            </tr><tr> \n                <td>5</td>\n                <td>11.25</td>\n                <td>22.5</td>\n            </tr><tr> \n                <td>6</td>\n                <td>5.625</td>\n                <td>11.25</td>\n            </tr><tr> \n                <td>7</td>\n                <td>2.813</td>\n                <td>5.625</td>\n            </tr>\n            <tr>\n                <td>...</td>\n                <td>...</td>\n                <td>...</td>\n            </tr>\n    </tbody>\n</table>\n",
    "operationId": "WebcamClusterController_getMapClusters",
    "parameters": [
     {
      "name": "lang",
      "required": false,
      "in": "query",
      "description": "### Specify the desired language for translating the results, if supported.",
      "schema": {
       "default": "en",
       "type": "string",
       "enum": [
        "ar",
        "bg",
        "bn",
        "ca",
        "cs",
        "da",
        "de",
        "el",
        "en",
        "es",
        "et",
        "fa",
        "fi",
        "fr",
        "he",
        "hi",
        "hr",
        "hu",
        "id",
        "is",
        "it",
        "ja",
        "ko",
        "lt",
        "nb",
        "nl",
        "pl",
        "pt",
        "ro",
        "ru",
        "sk",
        "sl",
        "sq",
        "sr",
        "sv",
        "ta",
        "th",
        "tr",
        "uk",
        "vi",
        "zh",
        "zh-TW"
       ]
      }
     },
     {
      "name": "northLat",
      "required": true,
      "in": "query",
      "description": "### Latitude (WGS84) of the north-east corner of the bounding box.\n- **Range**: *-90 to 90*",
      "schema": {
       "minimum": -90,
       "maximum": 90,
       "type": "number"
      }
     },
     {
      "name": "southLat",
      "required": true,
      "in": "query",
      "description": "### Latitude (WGS84) of the south-west corner of the bounding box.\n- **Range**: *-90 to 90*",
      "schema": {
       "minimum": -90,
       "maximum": 90,
       "type": "number"
      }
     },
     {
      "name": "eastLon",
      "required": true,
      "in": "query",
      "description": "### Longitude (WGS84) of the north-east corner of the bounding box.\n- **Range**: *-180 to 180*",
      "schema": {
       "minimum": -180,
       "maximum": 180,
       "type": "number"
      }
     },
     {
      "name": "westLon",
      "required": true,
      "in": "query",
      "description": "### Longitude (WGS84) of the south-west corner of the bounding box.\n- **Range**: *-180 to 180*",
      "schema": {
       "minimum": -180,
       "maximum": 180,
       "type": "number"
      }
     },
     {
      "name": "zoom",
      "required": true,
      "in": "query",
      "description": "### Specify the zoom level of the map.\n- **Range**: *4 to 18*",
      "schema": {
       "minimum": 4,
       "maximum": 18,
       "type": "integer"
      }
     },
     {
      "name": "include",
      "required": false,
      "in": "query",
      "description": "### Specify the content to be displayed in the result by defining the desired parts of the webcam feed.",
      "schema": {
       "uniqueItems": true,
       "type": "array",
       "items": {
        "type": "string",
        "enum": [
         "categories",
         "images",
         "location",
         "player",
         "urls"
        ]
       }
      },
      "explode": false
     }
    ],
    "responses": {
     "200": {
      "description": "",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/PublicApiWebcamResponseDto"
         }
        }
       }
      }
     }
    },
    "security": [
     {
      "public-api-key": []
     }
    ],
    "summary": "Returns a list of webcams optimized for displaying on a map for a given bounding box and zoom level",
    "tags": [
     "Webcams API V3"
    ]
   }
  },
