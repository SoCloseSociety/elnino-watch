 "info": {
  "title": "Webcams API",
  "description": "<section id='top-section'></section>",
  "version": "3.0",
  "contact": {}
 },
 "tags": [],
 "servers": [],
 "components": {
  "securitySchemes": {
   "public-api-key": {
    "type": "apiKey",
    "in": "header",
    "name": "x-windy-api-key",
    "description": "Insert your API key from https://api.windy.com/keys"
   }
  },
  "schemas": {
   "WebcamCategoriesDto": {
    "type": "object",
    "properties": {
     "id": {
      "enum": [
       "airport",
       "beach",
       "building",
       "city",
       "coast",
       "forest",
       "indoor",
       "lake",
       "landscape",
       "meteo",
       "mountain",
       "observatory",
       "port",
       "river",
       "sportArea",
       "square",
       "traffic",
       "village"
      ],
      "type": "string",
      "description": "The category ID to be used as a filter.",
      "example": "landscape"
     },
     "name": {
      "type": "string",
      "description": "The localized name of the category.",
      "example": "Outdoor"
     }
    },
    "required": [
     "id",
     "name"
    ]
   },
   "WebcamImagesDto": {
    "type": "object",
    "properties": {
     "current": {
      "type": "object"
     },
     "daylight": {
      "type": "object"
     },
     "sizes": {
      "type": "object",
      "additionalProperties": true
     }
    },
    "required": [
     "current",
     "daylight",
     "sizes"
    ]
   },
   "WebcamLocationDto": {
    "type": "object",
    "properties": {
     "latitude": {
      "type": "number",
      "description": "Latitude of the webcam in WGS84 coordinate system.",
      "example": -33.84903
     },
     "longitude": {
      "type": "number",
      "description": "Longitude of the webcam in WGS84 coordinate system.",
      "example": 151.21559
     },
     "city": {
      "type": "string",
      "description": "The translated name of the city in the desired language.",
      "example": "Sydney"
     },
     "city_code": {
      "type": "string",
      "description": "The geocode representing the city. It can be utilized as a modifier for the city filter.",
      "example": ""
     },
     "region": {
      "type": "string",
      "description": "The translated name of the region in the desired language.",
      "example": "New South Wales"
     },
     "region_code": {
      "type": "string",
      "description": "The geocode representing the region. It can be utilized as a modifier for the regions filter.",
      "example": "AU.02"
     },
     "country": {
      "type": "string",
      "description": "The translated name of the country in the desired language.",
      "example": "Australia"
     },
     "country_code": {
      "type": "string",
      "description": "The geocode representing the country. It can be utilized as a modifier for the countries filter.",
      "example": "AU"
     },
     "continent": {
      "type": "string",
      "description": "The translated name of the continent in the desired language.",
      "example": "Oceania"
     },
     "continent_code": {
      "type": "string",
      "description": "The geocode representing the continent. It can be utilized as a modifier for the continents filter.",
      "example": "OC"
     }
    },
    "required": [
     "latitude",
     "longitude",
     "city",
     "region",
     "country",
     "continent"
    ]
   },
   "WebcamPlayerUrlsDto": {
    "type": "object",
    "properties": {
     "live": {
      "type": "string",
      "description": "Link that allows embedding the live stream of this webcam into a website (using iframe) or app (using WebView on Android or UIWebView on iOS).",
      "example": "https://webcams.windy.com/webcams/public//player?webcamId=1179853135&playerType=live"
     },
     "day": {
      "type": "string",
      "description": "Link that allows embedding the daily timelapse of this webcam into a website (using iframe) or app (using WebView on Android or UIWebView on iOS).",
      "example": "https://webcams.windy.com/webcams/public//player?webcamId=1179853135&playerType=day"
     },
     "month": {
      "type": "string",
      "description": "Link that allows embedding the monthly timelapse of this webcam into a website (using iframe) or app (using WebView on Android or UIWebView on iOS).",
      "example": "https://webcams.windy.com/webcams/public//player?webcamId=1179853135&playerType=month"
     },
     "year": {
      "type": "string",
      "description": "Link that allows embedding the yearly timelapse of this webcam into a website (using iframe) or app (using WebView on Android or UIWebView on iOS).",
      "example": "https://webcams.windy.com/webcams/public//player?webcamId=1179853135&playerType=year"
     },
     "lifetime": {
      "type": "string",
      "description": "Link that allows embedding the lifetime timelapse of this webcam into a website (using iframe) or app (using WebView on Android or UIWebView on iOS).",
      "example": "https://webcams.windy.com/webcams/public//player?webcamId=1179853135&playerType=lifetime"
     }
    },
    "required": [
     "day",
     "month",
     "year",
     "lifetime"
    ]
   },
   "WebcamUrlsDto": {
    "type": "object",
    "properties": {
     "detail": {
      "type": "string",
      "description": "URL linking to the view of the webcam at windy.com.",
      "example": "https://webcams.windy.com/webcams/1179853135"
     },
     "edit": {
      "type": "string",
      "description": "URL for providing feedback to the webcam.",
      "example": "https://webcams-admin.windy.com/webcams/1179853135"
     },
     "provider": {
      "type": "string",
      "description": "Webcam provider URL"
     }
    },
    "required": [
     "detail",
     "edit",
     "provider"
    ]
   },
   "PublicApiWebcamResponseDto": {
    "type": "object",
    "properties": {
     "webcamId": {
      "type": "number",
      "description": "The unique identifier for this webcam. Can be used for calling the `/webcams/:webcamId` endpoint.",
      "example": 1179853135
     },
     "title": {
      "type": "string",
      "description": "Title of the webcam.",
      "example": "Sydney: Sydney Harbour Bridge - Sydney Opera House"
     },
     "status": {
      "enum": [
       "active",
       "inactive",
       "unapproved",
       "disabled",
       "rejected",
       "duplicate",
       "merged"
      ],
      "type": "string",
      "description": "Status of the webcam.",
      "example": "active"
     },
     "viewCount": {
      "type": "number",
      "description": "View count of this webcam since it was added to windy.com.",
      "example": 1282618
     },
     "lastUpdatedOn": {
      "type": "string",
      "description": "Timestamp of the most recent webcam update, formatted according to the ISO 8601 standard.",
      "example": "2012-03-08T12:17:24.000Z"
     },
     "clusterSize": {
      "type": "number",
      "description": "Indicates the count of webcams in the cluster that are represented by this webcam.",
      "example": 300
     },
     "categories": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/WebcamCategoriesDto"
      }
     },
     "images": {
      "$ref": "#/components/schemas/WebcamImagesDto"
     },
     "location": {
      "$ref": "#/components/schemas/WebcamLocationDto"
     },
     "player": {
      "$ref": "#/components/schemas/WebcamPlayerUrlsDto"
     },
     "urls": {
      "$ref": "#/components/schemas/WebcamUrlsDto"
     }
    },
    "required": [
     "webcamId",
     "title",
     "status",
     "viewCount",
     "lastUpdatedOn"
    ]
   },
   "WebcamDto": {
    "type": "object",
    "properties": {
     "webcamId": {
      "type": "number",
      "description": "The unique identifier for this webcam. Can be used for calling the `/webcams/:webcamId` endpoint.",
      "example": 1179853135
