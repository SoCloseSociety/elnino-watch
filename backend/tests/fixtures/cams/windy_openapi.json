  "/webcams/api/v3/webcams": {
   "get": {
    "description": "The API restricts the maximum number of webcams returned when using offset/limit pagination, based on the current tier of the subscription.",
    "operationId": "WebcamsController_getWebcams",
    "parameters": [
     {
      "name": "lang",
      "required": false,
      "in": "query",
      "description": "### Specify the desired language for translating the results, if supported.",
      "schema": {
       "default": "en",
       "type": "string",
       "enum": [
        "ar",
        "bg",
        "bn",
        "ca",
        "cs",
        "da",
        "de",
        "el",
        "en",
        "es",
        "et",
        "fa",
        "fi",
        "fr",
        "he",
        "hi",
        "hr",
        "hu",
        "id",
        "is",
        "it",
        "ja",
        "ko",
        "lt",
        "nb",
        "nl",
        "pl",
        "pt",
        "ro",
        "ru",
        "sk",
        "sl",
        "sq",
        "sr",
        "sv",
        "ta",
        "th",
        "tr",
        "uk",
        "vi",
        "zh",
        "zh-TW"
       ]
      }
     },
     {
      "name": "limit",
      "required": false,
      "in": "query",
      "description": "### Specify the maximum number of webcams to include in the returned list.\n- **Range**: *0 to 50*",
      "schema": {
       "minimum": 0,
       "maximum": 50,
       "default": 10,
       "type": "integer"
      }
     },
     {
      "name": "offset",
      "required": false,
      "in": "query",
      "description": "### Specify the starting position for pagination.\n- **Minimum**: *0*\n- **Maximum (for free API tier)**: *1000*\n- **Maximum (for professional API tier)**: *10000*",
      "schema": {
       "minimum": 0,
       "maximum": 100000,
       "default": 0,
       "type": "integer"
      }
     },
     {
      "name": "categoryOperation",
      "required": false,
      "in": "query",
      "description": "### Specify the operator to be used for categories (either `and` or `or`)..\n- The `categories` parameter is required for this operation.\n- The default value is `and`.",
      "schema": {
       "type": "string",
       "enum": [
        "and",
        "or"
       ]
      }
     },
     {
      "name": "sortKey",
      "required": false,
      "in": "query",
      "description": "### Returns a sorted list of webcams based on the specified order.",
      "schema": {
       "type": "string",
       "enum": [
        "popularity",
        "createdOn"
       ]
      }
     },
     {
      "name": "sortDirection",
      "required": false,
      "in": "query",
      "description": "### Specify the desired sort direction.",
      "schema": {
       "type": "string",
       "enum": [
        "asc",
        "desc"
       ]
      }
     },
     {
      "name": "bbox",
      "required": false,
      "in": "query",
      "description": "### Retrieves a list of webcams within the specified geographic bounding box.\n- **Use the following format for the bounding box coordinates:**\n  - **Format**: `{north_latitude},{east_longitude},{south_latitude},{west_longitude}`\n  - **Example**: <code><span>45.90,6.11,40.50,3.62</span></code>\n- **Latitude range**: *-90 to 90*\n- **Longitude range**: *-180 to 180*\n",
      "schema": {
       "pattern": "^(-?\\d+(\\.\\d+)?,){3}-?\\d+(\\.\\d+)?$",
       "type": "string"
      }
     },
     {
      "name": "nearby",
      "required": false,
      "in": "query",
      "description": "### Retrieves a list of webcams within a specified radius (in kilometers) around a given location.\n- **Use the following format for the nearby coordinates and radius:**\n  - **Format**: `{latitude},{longitude},{radius}`\n  - **Example**: <code><span>446.54,7.98,5</span></code>\n- **Latitude range**: *-90 to 90*\n- **Longitude range**: *-180 to 180*\n- **Maximal radius**: *250km*",
      "schema": {
       "pattern": "^(-?\\d+(\\.\\d+)?,){2}\\d+(\\.\\d+)?$",
       "type": "string"
      }
     },
     {
      "name": "categories",
      "required": false,
      "in": "query",
      "description": "### Returns a list of webcams based on the specified categories..\n- **Maximum number of categories**: *10*",
      "schema": {
       "maxItems": 10,
       "uniqueItems": true,
       "type": "array",
       "items": {
        "type": "string",
        "enum": [
         "airport",
         "beach",
         "building",
         "city",
         "coast",
         "forest",
         "indoor",
         "lake",
         "landscape",
         "meteo",
         "mountain",
         "observatory",
         "port",
         "river",
         "sportArea",
         "square",
         "traffic",
         "village"
        ]
       }
      },
      "explode": false
     },
     {
      "name": "continents",
      "required": false,
      "in": "query",
      "description": "### Returns a list of webcams located in continents specified by their continent geo codes.\n- Continent geo codes can be obtained by using `/continents` endpoint\n- **Maximum number of continents**: *2*",
      "schema": {
       "maxItems": 2,
       "uniqueItems": true,
       "type": "array",
       "items": {
        "type": "string",
        "enum": [
         "AF",
         "AN",
         "AS",
         "EU",
         "NA",
         "OC",
         "SA"
        ]
       }
      },
      "explode": false
     },
     {
      "name": "countries",
      "required": false,
      "in": "query",
      "description": "### Returns a list of webcams located in countries specified by their country geo codes.\n- Country geo codes can be obtained by using `/countries` endpoint\n- **Maximum number of countries**: *10*",
      "explode": false,
      "schema": {
       "uniqueItems": true,
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     {
      "name": "regions",
      "required": false,
      "in": "query",
      "description": "### Returns a list of webcams located in regions specified by their region geo codes.\n- Region geo codes can be obtained by using `/regions` endpoint\n- **Maximum number of regions**: *10*",
      "explode": false,
      "schema": {
       "uniqueItems": true,
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     {
      "name": "cities",
      "required": false,
      "in": "query",
      "schema": {
       "uniqueItems": true,
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     {
      "name": "webcamIds",
      "required": false,
      "in": "query",
      "description": "### Returns a list of webcams based on webcam ids\n**If webcamIds filter is set, no other filters are applied**\n- **Maximum number of webcams**: *50*",
      "explode": false,
      "schema": {
       "uniqueItems": true,
       "type": "array",
       "items": {
        "type": "integer"
       }
      }
     },
     {
      "name": "include",
      "required": false,
      "in": "query",
      "description": "### Specify the content to be displayed in the result by defining the desired parts of the webcam feed.",
      "schema": {
       "uniqueItems": true,
       "type": "array",
       "items": {
        "type": "string",
        "enum": [
         "categories",
         "images",
         "location",
         "player",
         "urls"
        ]
       }
      },
      "explode": false
     }
    ],
    "responses": {
     "200": {
      "description": "",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/WebcamsResponseDto"
        }
       }
      }
     }
    },
    "security": [
     {
      "public-api-key": []
     }
    ],
    "summary": "Returns a list of webcams according to the applied modifiers",
    "tags": [
     "Webcams API V3"
    ]
   }
  },
