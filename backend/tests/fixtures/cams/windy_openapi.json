       "active",
       "inactive",
       "unapproved",
       "disabled",
       "rejected",
       "duplicate",
       "merged"
      ],
      "type": "string",
      "description": "Status of the webcam.",
      "example": "active"
     },
     "viewCount": {
      "type": "number",
      "description": "View count of this webcam since it was added to windy.com.",
      "example": 1282618
     },
     "lastUpdatedOn": {
      "type": "string",
      "description": "Timestamp of the most recent webcam update, formatted according to the ISO 8601 standard.",
      "example": "2012-03-08T12:17:24.000Z"
     },
     "categories": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/WebcamCategoriesDto"
      }
     },
     "images": {
      "$ref": "#/components/schemas/WebcamImagesDto"
     },
     "location": {
      "$ref": "#/components/schemas/WebcamLocationDto"
     },
     "player": {
      "$ref": "#/components/schemas/WebcamPlayerUrlsDto"
     },
     "urls": {
      "$ref": "#/components/schemas/WebcamUrlsDto"
     }
    },
    "required": [
     "webcamId",
     "title",
     "status",
     "viewCount",
     "lastUpdatedOn"
    ]
   },
   "WebcamsResponseDto": {
    "type": "object",
    "properties": {
     "total": {
      "type": "number",
      "description": "The total count of webcams based on the specified filters.",
      "example": 1
     },
     "webcams": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/WebcamDto"
      }
     }
    },
    "required": [
     "total",
     "webcams"
    ]
   },
   "CategoryResponseDto": {
    "type": "object",
    "properties": {
     "id": {
      "enum": [
       "airport",
       "beach",
       "building",
       "city",
       "coast",
       "forest",
       "indoor",
       "lake",
       "landscape",
       "meteo",
       "mountain",
       "observatory",
       "port",
       "river",
       "sportArea",
       "square",
       "traffic",
       "village"
      ],
      "type": "string",
      "description": "Category ID, can be used as filter.",
      "example": "beach"
     },
     "name": {
      "type": "string",
      "description": "The localized name of the category.",
      "example": "Beach"
     }
    },
    "required": [
     "id",
     "name"
    ]
   },
   "PublicApiExportWebcamsItemResponseDto": {
    "type": "object",
    "properties": {
     "status": {
      "enum": [
       "active",
       "inactive",
       "unapproved",
       "disabled",
       "rejected",
       "duplicate",
       "merged"
      ],
      "type": "string"
     },
     "webcamId": {
      "type": "number"
     },
     "title": {
      "type": "string"
     },
     "viewCount": {
