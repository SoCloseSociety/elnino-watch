       "type": "string"
      }
     },
     "location": {
      "type": "object",
      "properties": {
       "latitude": {
        "type": "number"
       },
       "longitude": {
        "type": "number"
       },
       "regionCode": {
        "type": "string"
       },
       "countryCode": {
        "type": "string"
       },
       "continentCode": {
        "type": "string"
       }
      },
      "required": [
