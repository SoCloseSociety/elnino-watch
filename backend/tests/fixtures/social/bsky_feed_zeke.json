At": "2026-09-23T16:11:49.267Z", "$type": "app.bsky.feed.defs#reasonRepost"}, "opThreadPostIndex": 1, "opThreadPostCount": 2}, {"post": {"uri": "at://did:plc:xjnxcxe2pn5lwp6z2gxapbrl/app.bsky.feed.post/3mw4qgpeqe22u", "cid": "bafyreiapyco2teku5syppe5fvlk3mb3avav4wgdjzxlndtzd3zg6k7vydq", "author": {"did": "did:plc:xjnxcxe2pn5lwp6z2gxapbrl", "handle": "costasamaras.com", "displayName": "Costa Samaras", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:xjnxcxe2pn5lwp6z2gxapbrl/bafkreihczn76ipfogiynal2n22hunxqouwzlw24afaaxlagwdjirs63oei", "associated": {"chat": {"allowIncoming": "following"}, "activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [{"src": "did:plc:xjnxcxe2pn5lwp6z2gxapbrl", "uri": "at://did:plc:xjnxcxe2pn5lwp6z2gxapbrl/app.bsky.actor.profile/self", "cid": "bafyreihvbzw5w2xxmlsl2daougt45fqbdwfpiil3opf5vobdrcheutvvlm", "val": "!no-unauthenticated", "cts": "1970-01-01T00:00:00.000Z"}], "createdAt": "2023-05-16T03:15:49.539Z", "verification": {"verifications": [{"issuer": "did:plc:z72i7hdynmk6r22z27h6tvur", "issuerDisplayName": "Bluesky", "issuerHandle": "bsky.app", "uri": "at://did:plc:z72i7hdynmk6r22z27h6tvur/app.bsky.graph.verification/3lwnkbnnl2r2s", "isValid": true, "createdAt": "2025-08-18T04:20:28.031Z"}], "verifiedStatus": "valid", "trustedVerifierStatus": "none"}}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-09-22T17:21:36.840Z", "embed": {"$type": "app.bsky.embed.recordWithMedia", "media": {"$type": "app.bsky.embed.external", "external": {"description": "The U.S. Climate Collection has published its first paper, with 175 authors outlining research priorities for future U.S.-focused climate assessments.", "thumb": {"$type": "blob", "ref": {"$link": "bafkreid63zo677ea3zn53vs36zqot2tpvgi6yutz5oeqtowmm6uid3qyxe"}, "mimeType": "image/jpeg", "size": 789633}, "title": "First Paper Published in the U.S. Climate Collection", "uri": "https://headlines.ametsoc.org/2026/09/22/first-paper-published-in-the-u-s-climate-collection/"}}, "record": {"$type": "app.bsky.embed.record", "record": {"cid": "bafyreic6nbpuluhpdgdmz4vhjm5jh4kfwcigz4r2xzix3vekjjt2hlohvu", "uri": "at://did:plc:lwszjazwq3nliquvxg6l332b/app.bsky.feed.post/3mw4ca7qjnc2x"}}}, "facets": [{"$type": "app.bsky.richtext.facet", "features": [{"$type": "app.bsky.richtext.facet#mention", "did": "did:plc:lwszjazwq3nliquvxg6l332b"}], "index": {"byteEnd": 145, "byteStart": 133}}, {"features": [{"$type": "app.bsky.richtext.facet#link", "uri": "https://headlines.ametsoc.org/2026/09/22/first-paper-published-in-the-u-s-climate-collection/"}], "index": {"byteEnd": 296, "byteStart": 259}}], "langs": ["en"], "text": "Communities can't wait for the next National Climate Assessment to understand their climate risk. With leadership by Melissa Kenney, @bobkopp.net & I were lucky to work with 175 climate researchers to outline assessment priorities that folks can work on now: headlines.ametsoc.org/2026/09/22/f..."}, "embed": {"media": {"external": {"uri": "https://headlines.ametsoc.org/2026/09/22/first-paper-published-in-the-u-s-climate-collection/", "title": "First Paper Published in the U.S. Climate Collection", "description": "The U.S. Climate Collection has published its first paper, with 175 authors outlining research priorities for future U.S.-focused climate assessments.", "thumb": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:xjnxcxe2pn5lwp6z2gxapbrl/bafkreid63zo677ea3zn53vs36zqot2tpvgi6yutz5oeqtowmm6uid3qyxe"}, "$type": "app.bsky.embed.external#view"}, "record": {"record": {"uri": "at://did:plc:lwszjazwq3nliquvxg6l332b/app.bsky.feed.post/3mw4ca7qjnc2x", "cid": "bafyreic6nbpuluhpdgdmz4vhjm5jh4kfwcigz4r2xzix3vekjjt2hlohvu", "author": {"did": "did:plc:lwszjazwq3nliquvxg6l332b", "handle": "bobkopp.net", "displayName": "Bob Kopp", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:lwszjazwq3nliquvxg6l332b/bafkreiar4pttkzfrzim3sume5otxum5m3ccw35hajvpb57gwgrk2ti6vci", "associated": {"chat": {"allowIncoming": "following"}, "activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2023-09-12T10:28:32.896Z"}, "value": {"$type": "app.bsky.feed.post", "createdAt": "2026-09-22T13:07:26.315Z", "embed": {"$type": "app.bsky.embed.images", "images": [{"alt": "Kenney et al. (2026) Figure 2: Overview of the key research priorities identified in this commentary. The paper has 22 sections, organized into 5 groups—systems, settings, sectors, regions, and responses. These groups are reflected in the wheel, illustrating how research priorities are connected as part of a system that can span multiple research dimensions. Each section within the systems, settings, sectors, and responses groups has a text box summarizing core future research needs, as well as a box highlighting additional research priorities not covered in this commentary (“Additional Priorities”). The regions group highlights the geographic\nareas covered in this paper and acknowledges regional gaps; research priorities of included regions are presented in Fig. 3.", "aspectRatio": {"height": 2614, "width": 4000}, "image": {"$type": "blob", "ref": {"$link": "bafkreiaparmmouduwuze5nvathvodsw7quqhi4m4ed2za4yy7aaqsykbxy"}, "mimeType": "image/jpeg", "size": 1994528}}]}, "langs": ["en"], "reply": {"parent": {"cid": "bafyreihankovphrzunrdznly7coc65k6suzpjnfwq7k4ue3cc3zoyo73my", "uri": "at://did:plc:lwszjazwq3nliquvxg6l332b/app.bsky.feed.post/3mw4ca7dllc2x"}, "root": {"cid": "bafyreieixx5rjj52i6f3tgjkibxrqndl7kbpny7bwcyuhw4tvhl5rdm2w4", "uri": "at://did:plc:lwszjazwq3nliquvxg6l332b/app.bsky.feed.post/3mw4c3fdzws2x"}}, "text": "That's why we wrote this article. \n\nWe identify key assessment opportunities and research needs across 4 planetary systems (physical, social, ecological, economic), 5 environmental settings, 4 economic sectors, and 5 U.S. regions, as well as US international interests and key response strategies."}, "labels": [], "likeCount": 19, "replyCount": 1, "repostCount": 4, "quoteCount": 1, "indexe