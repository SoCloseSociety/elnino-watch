777777777777777}, "small": {"width": 640, "height": 360, "size": "640x360", "aspect": 1.7777777777777777}}, "description": null, "blurhash": "UNGb#O?bE1o3_NWXIBWYyDW=RkR*M_RkWEsT"}], "mentions": [], "tags": [{"name": "elnino", "url": "https://mastodon.social/tags/elnino"}, {"name": "calor", "url": "https://mastodon.social/tags/calor"}], "emojis": [], "tagged_collections": [], "quote": null, "card": null, "poll": null, "quote_approval": {"automatic": [], "manual": [], "current_user": "denied"}}, {"id": "117325600389427155", "created_at": "2026-09-24T10:42:34.000Z", "in_reply_to_id": null, "in_reply_to_account_id": null, "sensitive": false, "spoiler_text": "", "visibility": "public", "language": "en", "uri": "https://climatejustice.social/users/muellertadzio/statuses/117325598181820641", "url": "https://climatejustice.social/@muellertadzio/117325598181820641", "replies_count": 0, "reblogs_count": 0, "favourites_count": 1, "quotes_count": 0, "edited_at": null, "content": "<p>re: the current über <a href=\"https://climatejustice.social/tags/ElNi%C3%B1o\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>ElNiño</span></a>: imagine an unusually powerful El Niño, supercharged by an unprecedented level of warming, actually tipping the Pacific into another state:</p><p>\"The Holocene climate is not protected by some physical law simply because it's the world in which human civilisation developed.\"<br><a href=\"https://substack.com/home/post/p-216709236\" rel=\"nofollow noopener\" translate=\"no\" target=\"_blank\"><span class=\"invisible\">https://</span><span class=\"ellipsis\">substack.com/home/post/p-21670</span><span class=\"invisible\">9236</span></a></p>", "reblog": null, "account": {"id": "108193471567690291", "username": "muellertadzio", "acct": "muellertadzio@climatejustice.social", "display_name": "Tadzio Mueller", "locked": false, "bot": false, "discoverable": true, "indexable": false, "group": false, "created_at": "2022-04-25T00:00:00.000Z", "note": "<p>\"Regenbogenkommunist\" &amp; \"Grande Dame des Klimaextremismus\"</p><p>Ihr könnt mich ökon. unterstützen, indem Ihr meinen Newsletter friedlichesabotage.net als Freund*in abonniert. Gratis geht aber auch immer :)</p>", "url": "https://climatejustice.social/@muellertadzio", "uri": "https://climatejustice.social/users/muellertadzio", "avatar": "https://files.mastodon.social/cache/accounts/avatars/108/193/471/567/690/291/original/5f1654960c719498.jpg", "avatar_static": "https://files.mastodon.social/cache/accounts/avatars/108/193/471/567/690/291/original/5f1654960c719498.jpg", "avatar_description": "", "header": "https://files.mastodon.social/cache/accounts/headers/108/193/471/567/690/291/original/e945b747868a5334.webp", "header_static": "https://files.mastodon.social/cache/accounts/headers/108/193/471/567/690/291/original/e945b747868a5334.webp", "header_description": "", "followers_count": 3628, "following_count": 275, "statuses_count": 16647, "last_status_at": "2026-09-24", "hide_collections": false, "show_media": true, "show_media_replies": true, "show_featured": true, "feature_approval": {"automatic": ["public"], "manual": [], "current_user": "denied"}, "emojis": [], "fields": []}, "media_attachments": [], "mentions": [], "tags": [{"name": "elnino", "url": "https://mastodon.social/tags/elnino"}], "emojis": [], "tagged_collections": [], "quote": null, "card": {"url": "https://substack.com/home/post/p-216709236", "title": "El Padre: When El Niño Becomes the Climate", "description": "Millions of years ago, a warmer Earth had a very different tropical Pacific. As temperatures rise again, what can the Pliocene tell us about where we might be heading?", "language": "en", "type": "link", "author_name": "Peter Dynes", "author_url": "https://substack.com/@peterdynes", "provider_name": "Peter's Substack", "provider_url": "", "html": "", "width": 640, "height": 360, "image": "https://files.mastodon.social/cache/preview_cards/images/208/368/084/original/31d52a415b438a62.jpg", "image_description": "", "embed_url": "", "blurhash": "UaQk]F^%j:M{Q8o}pcXnnUNas8XT%LTeV[n$", "published_at": "2026-09-23T08:10:21.000Z", "authors": [{"name": "Peter Dynes", "url": "https://substack.com/@peterdynes", "account": null}]}, "poll": null, "quote_approval": {"automatic": ["public"], "manual": [], "current_user": "denied"}}, {"id": "117325548565238305", "created_at": "2026-09-24T10:29:46.000Z", "in_reply_to_id": null, "in_reply_to_account_id": null, "sensitive": false, "spoiler_text": "", "visibility": "public", "language": "en", "uri": "https://mathstodon.xyz/users/maxpool/statuses/117325547876933306", "url": "https://mathstodon.xyz/@maxpool/117325547876933306", "replies_count": 0, "reblogs_count": 1, "favourites_count": 0, "quotes_count": 0, "edited_at": "2026-09-24T10:34:11.000Z", "content": "<p class=\"quote-inline\">RE: <a href=\"https://mastodon.social/@Climatehistories/117324516873110884\" rel=\"nofollow noopener\" translate=\"no\" target=\"_blank\"><span class=\"invisible\">https://</span><span class=\"ellipsis\">mastodon.social/@Climatehistor</span><span class=\"invisible\">ies/117324516873110884</span></a></p><p>This discrepancy of human behavior is entirely normal. Irrational, but normal.</p><p>- new vs chronic threat detection (psychology)<br>- distance and future discounting<br>- narrative novelty and media economics<br>- adapting for changing environment psychologically and treating it as normal. <br>- immediate psychological and economic distress reduces long term planning. </p><p>We can't change humans, we must find ways that work within these psychological constraints and not treat them as anomalies.</p><p>Maybe we should predict both climate change and the human response together.</p><p>\"Huge El Niño projected to cause more than 450,000 deaths by February, cause mild reaction from the public in areas not affected, and cause small to moderate change in perceived threat and urgency in next 18 months\" </p><p><a href=\"https://mathstodon.xyz/tags/climatechange\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>climatechange</span></a> <a href=\"https://mathstodon.xyz/tags/elnino\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>elnino</span></a> <a href=\"https://mathstodon.xyz/tags/psycology\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>psycology</span></a></p>", "reblog": null, "account": {"id": "109301677076283103", "username": "maxpool", "acct": "maxpool@mathstodon.xyz", "display_name": "ma𝕏pool", "locked": false, "bot": false, "discoverable": true, "indexable": true, "group": false, "created_at": "2022-11-05T00:00:00.000Z", "note": "<p>Question: How many people like me does it take to screw in a light bulb?<br>Answer: 0.9967±0.004 (after six iterations).</p><p><a href=\"https://mathstodon.xyz/tags/NoBot\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>NoBot</span></a></p>", "url": "https://mathstodon.xyz/@maxpool", "uri": "https://mathstodon.xyz/users/maxpool", "avatar": "https://files.mastodon.social/cache/accounts/avatars/109/301/677/076/283/103/original/ad7eca47767e8d40.png", "avatar_static": "https://files.mastodon.social/cache/accounts/avatars/109/301/677/076/283/103/original/ad7eca47767e8d40.png", "avatar_description": "", "header": "https://files.mastodon.social/cache/accounts/headers/109/301/677/076/283/103/original/341aae02deae81ea.png", "header_static": "https://files.mastodon.social/cache/accounts/headers/109/301/677/076/283/103/original/341aae02deae81ea.png", "header_description": "", "followers_count": 326, "following_count": 307, "statuses_count": 617, "last_status_at": "2026-09-24", "hide_collections": true, "show_media": true, "show_media_replies": true, "show_featured": true, "feature_approval": {"automatic": ["public"], "manual": [], "current_user": "denied"}, "emojis": [], "fields": []}, "media_attachments": [], "mentions": [], "tags": [{"name": "psycology", "url": "https://mastodon.social/tags/psycology"}, {"name": "elnino", "url": "https://mastodon.social/tags/elnino"}, {"name": "climatechange", "url": "https://mastodon.social/tags/climatechange"}], "emojis": [], "tagged_collections": [], "quote": {"state": "accepted", "quoted_status": {"id": "117324516873110884", "created_at": "2026-09-24T06:07:34.831Z", "in_reply_to_id": null, "in_reply_to_account_id": null, "sensitive": false, "spoiler_text": "", "visibility": "public", "language": "en", "uri": "https://mastodon.social/users/Climatehistories/statuses/117324516873110884", "url": "https://mastodon.social/@Climatehistories/117324516873110884", "replies_count": 11, "reblogs_count": 151, "favourites_count": 123, "quotes_count": 2, "edited_at": "2026-09-24T06:10:19.992Z", "content": "<p>It’s crazy how all these real problems around the world - the heat, floods, fires, all getting worse with this huge El Niño - barely get talked about in the media, while everyone is getting wild  about AI going rogue. </p><p>Sure, AI might be a big risk someday, but climate change is already happening and it is relentless. </p><p>And somehow we are not treating it as the urgent real-time crisis it is. </p><p><a href=\"https://www.theguardian.com/environment/2026/sep/23/el-nino-450000-extra-deaths-six-months\" target=\"_blank\" rel=\"nofollow noopener\" translate=\"no\"><span class=\"invisible\">https://www.</span><span class=\"ellipsis\">theguardian.com/environment/20</span><span class=\"invisible\">26/sep/23/el-nino-450000-extra-deaths-six-months</span></a></p><p><a href=\"https://mastodon.social/tags/climatechange\" class=\"mention hashtag\" rel=\"tag\">#<span>climatechange</span></a> <a href=\"https://mastodon.social/tags/elnino\" class=\"mention hashtag\" rel=\"tag\">#<span>elnino</span></a></p>", "reblog": null, "account": {"id": "108191409912507109", "username": "Climatehistories", "acct": "Climatehistories", "display_name": "The Climate Historian", "locked": false, "bot": false, "discoverable": true, "indexable": true, "group": false, "created_at": "2022-04-25T00:00:00.000Z", "note": "<p>I write about geopolitics and the history of climate change. <br />Sometimes, I just chat about books or whatever else grabs my attention.</p><p>Posts auto-delete because the Internet&#39;s too cluttered and most posts are not worth keeping anyway.</p>", "url": "https://mastodon.social/@Climatehistories", "uri": "https://mastodon.social/users/Climatehistories", "avatar": "https://files.mastodon.social/accounts/avatars/108/191/409/912/507/109/original/03464ebcd8c08d56.jpg", "avatar_static": "https://files.mastodon.social/accounts/avatars/108/191/409/912/507/109/original/03464ebcd8c08d56.jpg", "avatar_description": "", "header": "https://files.mastodon.social/accounts/headers/108/191/409/912/507/109/original/238cfbeb3683ef97.webp", "header_static": "https://files.mastodon.social/accounts/headers/108/191/409/912/507/109/original/238cfbeb3683ef97.webp", "header_description": "", "followers_count": 2258, "following_count": 90, "statuses_count": 103, "last_status_at": "2026-09-24", "hide_collections": true, "show_media": true, "show_media_replies": true, "show_featured": true, "noindex": false, "feature_approval": {"automatic": ["public"], "manual": [], "current_user": "denied"}, "emojis": [], "roles": [], "fields": [{"name": "https://theclimatehistorian.substack.com", "value": "The Climate Historian", "verified_at": null}]}, "media_attachments": [], "mentions": [], "tags": [{"name": "climatechange", "url": "https://mastodon.social/tags/climatechange"}, {"name": "elnino", "url": "https://mastodon.social/tags/elnino"}], "emojis": [], "tagged_collections": [], "quote": null, "card": {"url": "https://www.theguardian.com/environment/2026/sep/23/el-nino-450000-extra-deaths-six-months", "title": "Huge El Niño projected to cause more than 450,000 deaths by February", "description": "New report predicts a heavy toll from Nigeria to the US – and comes on top of existing impacts of the climate crisis", "language": "en", "type": "link", "author_name": "Damian Carrington", "author_url": "", "provider_name": "The Guardian", "provider_url": "", "html": "", "width": 662, "height": 348, "image": "https://files.mastodon.social/cache/preview_cards/images/208/196/937/original/8200e023b94452dd.jpg", "image_description": "", "embed_url": "", "blurhash": "UQE.eRMw0er=kCRkM{tQkYxuIUM_jDxakDM_", "published_at": "2026-09-23T04:00:15.000Z", "authors": [{"name": "Damian Carrington", "url": "", "account": null}]}, "poll": null, "quote_approval": {"automatic": ["public"], "manual": [], "current_user": "denied"}}}, "card": null, "poll": null, "quote_approval": {"automatic": ["public"], "manual": [], "current_user": "denied"}}, {"id": "117325001951232349", "created_at": "2026-09-24T08:10:56.537Z", "in_reply_to_id": null, "in_reply_to_account_id": null, "sensitive": false, "spoiler_text": "", "visibility": "public", "language": "es", "uri": "https://mastodon.social/users/tutiempo/statuses/117325001951232349", "url": "https://mastodon.social/@tutiempo/117325001951232349", "replies_count": 0, "reblogs_count": 0, "favourites_count": 0, "quotes_count": 0, "edited_at": null, "content": "<p>La OMM y la OMS advierten sobre el recrudecimiento de El Niño a finales de 2026. Analizamos su impacto en olas de calor, dengue, cólera y seguridad alimentaria.</p><p><a href=\"https://mastodon.social/tags/OMM\" class=\"mention hashtag\" rel=\"tag\">#<span>OMM</span></a> <a href=\"https://mastodon.social/tags/OMS\" class=\"mention hashtag\" rel=\"tag\">#<span>OMS</span></a> <a href=\"https://mastodon.social/tags/ElNi%C3%B1o\" class=\"mention hashtag\" rel=\"tag\">#<span>ElNiño</span></a> <a href=\"https://mastodon.social/tags/Alerta\" class=\"mention hashtag\" rel=\"tag\">#<span>Alerta</span></a> <a href=\"https://mastodon.social/tags/Tutiempo\" class=\"mention hashtag\" rel=\"tag\">#<span>Tutiempo</span></a></p><p><a href=\"https://www.tutiempo.net/noticias/alerta-sanitaria-mundial-ante-intensificacion-de-el-nino.html\" target=\"_blank\" rel=\"nofollow noopener\" translate=\"no\"><span class=\"invisible\">https://www.</span><span class=\"ellipsis\">tutiempo.net/noticias/alerta-s</span><span class=\"invisible\">anitaria-mundial-ante-intensificacion-de-el-nino.html</span></a></p>", "reblog": null, "application": {"name": "Web", "website": null}, "account": {"id": "115268274702473134", "username": "tutiempo", "acct": "tutiempo", "display_name": "Tutiempo.net", "locked": false, "bot": false, "discoverable": true, "indexable": true, "group": false, "created_at": "2025-09-26T00:00:00.000Z", "note": "<p>El tiempo por Tutiempo.net<br /><a href=\"https://www.tutiempo.net\" target=\"_blank\" rel=\"nofollow noopener\" translate=\"no\"><span class=\"invisible\">https://www.</span><span class=\"\">tutiempo.net</span><span class=\"invisible\"></span></a><br />La previsión del tiempo con el pronostico meteorológico para todos los países y ciudades principales del mundo y especial España. Información climática, astronomía, noticias, terremotos, etc..</p>", "url": "https://mastodon.social/@tutiempo", "uri": "https://mastodon.social/users/tutiempo", "avatar": "https://files.mastodon.social/accounts/avatars/115/268/274/702/473/134/original/3537bcdd00ac67ca.png", "avatar_static": "https://files.mastodon.social/accounts/avatars/115/268/274/702/473/134/original/3537bcdd00ac67ca.png", "avatar_description": "", "header": "https://files.mastodon.social/accounts/headers/115/268/274/702/473/134/original/248c02fc0e9496f7.png", "header_static": "https://files.mastodon.social/accounts/headers/115/268/274/702/473/134/original/248c02fc0e9496f7.png", "header_description": "", "followers_count": 39, "following_count": 2, "statuses_count": 1731, "last_status_at": "2026-09-24", "hide_collections": null, "show_media": true, "show_media_replies": true, "show_featured": true, "noindex": false, "feature_approval": {"automatic": ["public"], "manual": [], "c