criptions": "followers"}}, "labels": [], "createdAt": "2023-12-03T00:44:04.261Z"}, "value": {"$type": "app.bsky.feed.post", "createdAt": "2026-09-17T15:14:19.484Z", "embed": {"$type": "app.bsky.embed.record", "record": {"cid": "bafyreifeip35odd2agvh7bmt2avhqjaibnx6bozmg3e5lrbtrkgjjku3pu", "uri": "at://did:plc:wznrpi4wyqhcv5onowp3lmcs/app.bsky.feed.post/3mvpptprw7s2g"}}, "facets": [{"$type": "app.bsky.richtext.facet", "features": [{"$type": "app.bsky.richtext.facet#mention", "did": "did:plc:wznrpi4wyqhcv5onowp3lmcs"}], "index": {"byteEnd": 125, "byteStart": 99}}], "langs": ["en"], "text": "The mind reels when contemplating what a repeat of the 1926 Miami hurricane would look like today. @drjeffmasters.bsky.social's superb overview is well worth reading and pondering, especially if you're coming in cold to this behemoth."}, "labels": [], "likeCount": 25, "replyCount": 0, "repostCount": 7, "quoteCount": 1, "indexedAt": "2026-09-17T15:14:20.261Z", "embeds": [{"record": {"uri": "at://did:plc:wznrpi4wyqhcv5onowp3lmcs/app.bsky.feed.post/3mvpptprw7s2g", "cid": "bafyreifeip35odd2agvh7bmt2avhqjaibnx6bozmg3e5lrbtrkgjjku3pu", "author": {"did": "did:plc:wznrpi4wyqhcv5onowp3lmcs", "handle": "drjeffmasters.bsky.social", "displayName": "Dr. Jeff Masters", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:wznrpi4wyqhcv5onowp3lmcs/bafkreifxn2kfuhcukon6bq2sldui6zoxfzyziutofhi4dg3d5siw6cr4uq", "associated": {"chat": {"allowIncoming": "following"}, "activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2023-09-02T18:06:54.404Z"}, "value": {"$type": "app.bsky.feed.post", "createdAt": "2026-09-17T13:06:23.139Z", "embed": {"$type": "app.bsky.embed.external", "external": {"description": "'Late that night, in absolute darkness, it hit, with the far shrieking screams, the queer rumbling of a vast and irresistible freight train,' Marjory Stoneman Douglas wrote of the storm.", "thumb": {"$type": "blob", "ref": {"$link": "bafkreiedzx7xybgw4lipjtlrwebs77w26oj56p2le4bzzikkpdgn4txhxi"}, "mimeType": "image/jpeg", "size": 362688}, "title": "A look back at the devastating Great Miami Hurricane, 100 years later » Yale Climate Connections", "uri": "https://yaleclimateconnections.org/2026/09/a-look-back-at-the-devastating-great-miami-hurricane-100-years-later/"}}, "langs": ["en"], "text": "100 years ago: “The 1926 hurricane has become a benchmark in South Florida history, a dividing point in time, much like B.C. and A.D. It has achieved a mystique of almost biblical proportions — akin to Noah’s flood or the destruction of Sodom and Gomorrah.” — Miami historian Arva Moore Parks."}, "labels": [], "likeCount": 53, "replyCount": 1, "repostCount": 14, "quoteCount": 2, "indexedAt": "2026-09-17T13:06:24.783Z", "$type": "app.bsky.embed.record#viewRecord"}, "$type": "app.bsky.embed.record#view"}], "$type": "app.bsky.embed.record#viewRecord"}, "$type": "app.bsky.embed.record#view"}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 0, "likeCount": 2, "quoteCount": 0, "indexedAt": "2026-09-17T15:15:41.667Z", "labels": []}}, {"post": {"uri": "at://did:plc:3xsqh5tzimnjhalvx2cntwos/app.bsky.feed.post/3mvm3n2sg4c2s", "cid": "bafyreihewolkm226qeaivpewcohq4pnztnkeywfn476vthfnhfrxdlde6a", "author": {"did": "did:plc:3xsqh5tzimnjhalvx2cntwos", "handle": "oceanstwx.bsky.social", "displayName": "Chris Legro", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:3xsqh5tzimnjhalvx2cntwos/bafkreietavp63iyhcdmgvwgmp366v5tnwr6ysobrds322fcve6vmp6kei4", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2024-02-14T15:45:36.911Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-09-16T02:26:45.757Z", "embed": {"$type": "app.bsky.embed.images", "images": [{"alt": "", "aspectRatio": {"height": 72, "width": 454}, "image": {"$type": "blob", "ref": {"$link": "bafkreiedvtab2cl66x5jprq6hrkxawvnjoa2bzs3tzhmlx7iahs6qzzcv4"}, "mimeType": "image/jpeg", "size": 52979}}]}, "langs": ["en"], "tex