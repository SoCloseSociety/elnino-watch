cg2qzslt4bhuhztmp2uzqqkrw32kiqm", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2024-10-15T01:59:01.408Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-09-18T16:55:22.916Z", "embed": {"$type": "app.bsky.embed.images", "images": [{"alt": "Time series plot of the color-coded Arctic-wide annual minimum sea ice extent 1979 to 2026 based on analysis by the National Snow and Ice Data Center. Also shown is an estimate of the time varying average.", "aspectRatio": {"height": 900, "width": 1500}, "image": {"$type": "blob", "ref": {"$link": "bafkreihmy4kqw5sus5uocgeoogqeu2qi6jfdagvrqcrk77rqk6m3wk3plu"}, "mimeType": "image/jpeg", "size": 327981}}]}, "facets": [{"features": [{"$type": "app.bsky.richtext.facet#tag", "tag": "Arctic"}], "index": {"byteEnd": 289, "byteStart": 282}}, {"features": [{"$type": "app.bsky.richtext.facet#tag", "tag": "SeaIce"}], "index": {"byteEnd": 297, "byteStart": 290}}], "langs": ["en"], "text": "Arctic-wide sea ice extent has (very likely) reached the minimum for 2026 In NSIDC analysis. At 4.60 million square kilometers (about 2.5 times the size of Alaska), this ties with last year for the 11th lowest since 1979. But that's still lower than every year's min prior to 2007. #Arctic #SeaIce"}, "embed": {"images": [{"thumb": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:rtveuwu2loqgrd5hqjjmwwbf/bafkreihmy4kqw5sus5uocgeoogqeu2qi6jfdagvrqcrk77rqk6m3wk3plu", "fullsize": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:rtveuwu2loqgrd5hqjjmwwbf/bafkreihmy4kqw5sus5uocgeoogqeu2qi6jfdagvrqcrk77rqk6m3wk3plu", "alt": "Time series plot of the color-coded Arctic-wide annual minimum sea ice extent 1979 to 2026 based on analysis by the National Snow and Ice Data Center. Also shown is an estimate of the time varying average.", "aspectRatio": {"height": 900, "width": 1500}}], "$type": "app.bsky.embed.images#view"}, "bookmarkCount": 1, "replyCount": 0, "repostCount": 8, "likeCount":