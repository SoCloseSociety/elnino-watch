": {"uri": "at://did:plc:va5sthipulczpm5ehgs7dwpq/app.bsky.feed.post/3mvqdeejrsk2m", "cid": "bafyreifcgmfubyyqn2xtizgewwbflxsga25die2kobaurc3gjypkwvoax4", "author": {"did": "did:plc:va5sthipulczpm5ehgs7dwpq", "handle": "emorwee.bsky.social", "displayName": "Emily Atkin", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:va5sthipulczpm5ehgs7dwpq/bafkreifszrphxaxizqq2gazo25pvpbosikuvpprupfgr53fh4qaj7fd4bq", "associated": {"activitySubscription": {"allowSubscriptions": "followers"}}, "labels": [], "createdAt": "2023-05-09T22:59:38.767Z"}, "record": {"$type": "app.bsky.feed.post", "createdAt": "2026-09-17T18:55:42.857Z", "embed": {"$type": "app.bsky.embed.external", "external": {"description": "What are buyers being told about climate risk in Miami? I posed as one to find out.", "thumb": {"$type": "blob", "ref": {"$link": "bafkreiecsyme6u7wz5jh7bn6epkyrt2zmv6phdpgjhajtrqtjhcy5lovom"}, "mimeType": "image/jpeg", "size": 665723}, "title": "The open houses at the edge of disaster", "uri": "https://heated.world/p/the-open-houses-at-the-edge-of-disaster"}}, "langs": ["en"], "text": "A few weekends ago I went to Miami and attended 9 open houses in extremely high-risk flood areas to see what agents are telling prospective buyers about them.\n\nHere is my journey"}, "embed": {"external": {"uri": "https://heated.world/p/the-open-houses-at-the-edge-of-disaster", "title": "The open houses at the edge of disaster", "description": "What are buyers being told about climate risk in Miami? I posed as one to find out.", "thumb": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:va5sthipulczpm5ehgs7dwpq/bafkreiecsyme6u7wz5jh7bn6epkyrt2zmv6phdpgjhajtrqtjhcy5lovom"}, "$type": "app.bsky.embed.external#view"}, "bookmarkCount": 159, "replyCount": 42, "repostCount": 391, "likeCount": 1260, "quoteCount": 99, "indexedAt": "2026-09-17T18:55:44.468Z", "labels": []}, "reason": {"by": {"did": "did:plc:qrorc5gyaslujsghpmxqfu3r", "handle": "tdiliberto.bsky.social", "displayName": "Tom Di Li