eType": "image/jpeg", "size": 370637}}]}, "facets": [{"features": [{"$type": "app.bsky.richtext.facet#tag", "tag": "Polo"}], "index": {"byteEnd": 5, "byteStart": 0}}], "langs": ["en"], "text": "#Polo was a tropical storm yesterday.\nToday it is a Cat 5 hurricane.\n\n110 mph gained in just 24 hours. Almost doubling the threshold of Extreme Rapid Intensification.\n\nFueling it: ocean warmth ~3-3.5°F above average, made up to 200x more likely by heat-trapping pollution."}, "labels": [], "likeCount": 7, "replyCount": 1, "repostCount": 3, "quoteCount": 2, "indexedAt": "2026-09-22T14:22:22.164Z", "embeds": [{"images": [{"thumb": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:vv7ncq7yo3egwxa5fuojwrbg/bafkreia4xtfttnr4rkpvxx3zauo3kltex6ijwp2wuhvylznszbxhibrxtu", "fullsize": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:vv7ncq7yo3egwxa5fuojwrbg/bafkreia4xtfttnr4rkpvxx3zauo3kltex6ijwp2wuhvylznszbxhibrxtu", "alt": "", "aspectRatio": {"height": 1000, "width": 1000}}, {"thumb": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:vv7ncq7yo3egwxa5fuojwrbg/bafkreib25vu5uk4yixt6pvokwpl5du2bnrv3x3uyke6blowxrbbbqx7j5m", "fullsize": "https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:vv7ncq7yo3egwxa5fuojwrbg/bafkreib25vu5uk4yixt6pvokwpl5du2bnrv3x3uyke6blowxrbbbqx7j5m", "alt": "", "aspectRatio": {"height": 907, "width": 1061}}], "$type": "app.bsky.embed.images#view"}], "$type": "app.bsky.embed.record#viewRecord"}, "$type": "app.bsky.embed.record#view"}, "bookmarkCount": 0, "replyCount": 0, "repostCount": 2, "likeCount": 7, "quoteCount": 0, "indexedAt": "2026-09-23T02:48:34.767Z", "labels": []}}, {"post": {"uri": "at://did:plc:qrorc5gyaslujsghpmxqfu3r/app.bsky.feed.post/3mw32ql736k2v", "cid": "bafyreicnw4yo4epcppyex3alcqsn2p4gjb4s6baezmfl4bfqgr57dxpw6y", "author": {"did": "did:plc:qrorc5gyaslujsghpmxqfu3r", "handle": "tdiliberto.bsky.social", "displayName": "Tom Di Liberto", "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:qrorc5gyaslujsghpmxqfu3r/bafkreigony